{
  "name": "xmermaid",
  "version": "0.1.0",
  "description": "Flowchart-focused Mermaid renderer with partial Mermaid support powered by Rust WASM",
  "type": "module",
  "main": "dist/xmermaid.cjs",
  "module": "dist/xmermaid.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/xmermaid.esm.js",
      "require": "./dist/xmermaid.cjs",
      "types": "./dist/index.d.ts"
    },
    "./editor": {
      "import": "./dist/xmermaid.esm.js",
      "require": "./dist/xmermaid.cjs",
      "types": "./dist/editor/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:wasm": "node scripts/build-wasm.cjs",
    "build:js": "rollup -c",
    "build": "npm run build:wasm && npm run build:js && node scripts/copy-wasm-dist.cjs",
    "verify:release": "node scripts/verify-release.cjs",
    "smoke:consumer": "node scripts/consumer-smoke.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "jsdom": "^29.1.0",
    "rollup": "^4.18.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "ws": "^8.20.0"
  },
  "keywords": [
    "mermaid",
    "diagram",
    "wasm",
    "rust",
    "svg",
    "flowchart"
  ],
  "license": "MIT",
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
